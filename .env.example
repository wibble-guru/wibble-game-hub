# 위블 사이트 주소. 직접 접속한 사람을 {SITE_URL}/t/{siteSlug} 로 보낸다
SITE_URL=https://wibble.guru
# 게임을 iframe으로 띄워도 되는 사이트 origin (쉼표 구분). 비우면 SITE_URL 하나만
ALLOWED_EMBEDDERS=https://wibble.guru
# 허브 첫 화면(게임 모아 보기) 로그인. 둘 다 있어야 열린다
HUB_USER=
HUB_PASSWORD=
# 게임 서버 응답 대기 시간 (기본 10000ms)
UPSTREAM_TIMEOUT_MS=
# 게임별 설정. {SLUG}는 대문자, 하이픈은 밑줄 (court -> COURT)
#   UPSTREAM_{SLUG}  게임 서버 주소를 바꿀 때 (로컬: http://localhost:4173)
#   BYPASS_{SLUG}    게임 프로젝트 Deployment Protection의 "Protection Bypass for Automation" 값
UPSTREAM_COURT=
BYPASS_COURT=
